# Postgres connection — point at docker-compose locally, Neon in deployed envs.
DATABASE_URL=postgres://fit:fit@localhost:5432/fit_backend?sslmode=disable

# Firebase project ID. Firebase ID tokens carry this as their `aud` claim, so the
# verifier rejects anything signed for a different project. Matches the Flutter app's
# google-services.json project_id.
FIREBASE_PROJECT_ID=fit-cp-tanmay

# Optional. Path to a Firebase service account JSON. On GCP (Cloud Run) leave this
# unset and ADC kicks in. Locally you can either set it to a downloaded service
# account file or set AUTH_DISABLED=true to skip verification entirely.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json

# Port the HTTP server listens on.
PORT=8080

# When true, the auth middleware injects uid="dev" and skips token verification.
# Use only for local development.
AUTH_DISABLED=false
