# Copy to .env.cloudrun and fill in values. Gitignored.

# GCP project hosting the Cloud Run service.
GCP_PROJECT=your-gcp-project

# Region for Cloud Run (and Artifact Registry repo, if used).
REGION=us-central1

# Service name. Becomes part of the URL: https://SERVICE_NAME-...-a.run.app
SERVICE_NAME=fit-backend

# Neon Postgres connection string. Keep sslmode=require for Neon.
# Example: postgres://user:pass@ep-xxx.us-east-2.aws.neon.tech/fit_backend?sslmode=require
NEON_DATABASE_URL=postgres://user:pass@host.neon.tech/fit_backend?sslmode=require

# Firebase project ID — same as android/app/google-services.json.
FIREBASE_PROJECT_ID=fit-cp-tanmay

# Name of the Secret Manager secret holding the Firebase service account JSON.
# Cloud Run mounts it at /secrets/firebase-creds/key.json via the script.
FIREBASE_CREDS_SECRET=fit-backend-firebase

# Container image tag (built locally then pushed). The script will run gcloud builds
# submit if the image does not exist remotely.
IMAGE_TAG=us-central1-docker.pkg.dev/your-gcp-project/fit/fit-backend:latest
